# Web server-only configuration. Copy to `.env` for local development; never expose secrets with
# NEXT_PUBLIC_* names because those values are embedded in the browser bundle.
BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://mingles.cloud

# Optional store links shown on the landing page.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=

# Public legal operator facts. Production VM image builds require all seven via
# BuildKit secret `web_env` (`docker/web.Dockerfile`); do not commit real values.
# Use the exact registered business data; do not use sample or placeholder values.
LEGAL_OPERATOR_NAME=
LEGAL_REPRESENTATIVE=
LEGAL_BUSINESS_NUMBER=
LEGAL_MAIL_ORDER_NUMBER=
LEGAL_ADDRESS=
LEGAL_PRIVACY_OFFICER=
# Legal-reviewed processor/international-transfer disclosure: provider, country,
# transfer timing/method, items, purpose, retention, and refusal consequences.
LEGAL_PROCESSORS_DISCLOSURE=
